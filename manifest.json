{
  "manifest_version": 3,
  "name": "Google Meet Recorder",
  "version": "1.1.0",
  "description": "Nagrywa i eksportuje transkrypcję z Google Meet",
  "permissions": [
    "activeTab",
    "storage",
    "downloads",
    "scripting"
  ],
  "host_permissions": [
    "https://meet.google.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["debug-config.js", "js/utils/google-user-detector.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "commands": {
    "toggle-recording": {
      "suggested_key": {
        "default": "Alt+Shift+R",
        "mac": "MacCtrl+Shift+R"
      },
      "description": "Rozpocznij/zatrzymaj nagrywanie"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["prompt.md"],
      "matches": ["https://meet.google.com/*"]
    }
  ]
}